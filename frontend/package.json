{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "jest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.4",
    "dayjs": "^1.11.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.7.0",
    "vite": "^8.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "\\.(css|svg|png|jpg)$": "<rootDir>/src/__mocks__/fileMock.ts",
      "^antd$": "<rootDir>/src/__mocks__/antd.tsx",
      "^@ant-design/icons$": "<rootDir>/src/__mocks__/icons.tsx",
      "^@ant-design/icons/(.*)$": "<rootDir>/src/__mocks__/icons.tsx"
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@ant-design|antd|rc-.+|@babel|dayjs)/)"
    ]
  }
}
